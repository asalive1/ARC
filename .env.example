# Local development only. Use URL-safe characters: A-Z, a-z, 0-9, _ or -.
ARC_POSTGRES_PASSWORD=replace_with_url_safe_local_password
ARC_API_PORT=8080
ARC_UI_PORT=3000
ARC_ADMIN_COOKIE_SECURE=false
# Generate these one-time files with .\deploy\new-admin-secrets.ps1.
ARC_ADMIN_BOOTSTRAP_TOKEN_FILE_SOURCE=./secrets/admin_bootstrap_token.txt
ARC_ADMIN_RECOVERY_TOKEN_FILE_SOURCE=./secrets/admin_recovery_token.txt
# Set a real public DNS name and contact address before using compose.acme.yaml.
ARC_PUBLIC_DOMAIN=arc.example.com
ARC_ACME_EMAIL=operator@example.com

# Optional worker profile. Generate a unique worker UUID and 64-character
# hexadecimal token, and make the worker use a trusted WSS endpoint.
# ARC_WORKER_ID=
# ARC_WORKER_NAME=arc-worker-local
# ARC_WORKER_CONTROL_ENDPOINT=wss://your-trusted-ingress.example/api/v1/workers/control
# Optional PEM CA bundle path inside the worker container; mount read-only in a Compose override.
# ARC_WORKER_CONTROL_CA_FILE=/etc/arc/trust/worker-ca.pem
# ARC_WORKER_CONTROL_TOKEN=
# ARC_WORKER_CREDENTIALS_JSON={"<worker-uuid>":"<64-character-hex-token>"}
# Secret-files override (use with compose.secrets.yaml):
# ARC_WORKER_CREDENTIALS_FILE_SOURCE=./secrets/worker_credentials.json
# ARC_WORKER_CONTROL_TOKEN_FILE_SOURCE=./secrets/worker_control_token.txt
# ARC_WORKER_TLS_PORT=8443
# ARC_WORKER_CAPACITY_UNITS=2
ARC_WORKER_INGRESS_BITS_PER_SECOND=
ARC_WORKER_EGRESS_BITS_PER_SECOND=
# Optional static overrides; otherwise CPU and memory utilization are measured.
ARC_WORKER_CPU_UTILIZATION_RATIO=
ARC_WORKER_MEMORY_UTILIZATION_RATIO=
# ARC_WORKER_ENABLE_ALSA=false
