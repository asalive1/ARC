FROM rust:1-bookworm AS build

WORKDIR /workspace
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        libgstreamer1.0-dev \
        libgstreamer-plugins-base1.0-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY database ./database
RUN cargo build --locked --release --package arc-worker --bin arc-worker --features gstreamer-runtime

FROM debian:bookworm-slim AS gst-srt-plugin

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        gstreamer1.0-plugins-bad \
    && plugin="$(find /usr/lib -type f -path '*/gstreamer-1.0/libgstsrt.so' -print -quit)" \
    && test -n "$plugin" \
    && mkdir -p /out \
    && cp "$plugin" /out/libgstsrt.so \
    && rm -rf /var/lib/apt/lists/*

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        gstreamer1.0-alsa \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        libsrt1.5-gnutls \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /workspace/target/release/arc-worker /usr/local/bin/arc-worker
COPY --from=gst-srt-plugin /out/libgstsrt.so /usr/local/lib/gstreamer-1.0/libgstsrt.so
ENV GST_REGISTRY=/tmp/gst-registry.bin \
    GST_PLUGIN_PATH_1_0=/usr/local/lib/gstreamer-1.0
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/arc-worker"]
