FROM rust:1-slim AS build

WORKDIR /workspace
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY database ./database
RUN cargo build --locked --release --package arc-api

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /workspace/target/release/arc-api /usr/local/bin/arc-api
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/arc-api"]
